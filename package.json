{
  "name": "portal-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac-dmg": "tauri build --bundles dmg",
    "build:win-exe": "tauri build --bundles nsis",
    "package:mac-dmg": "mkdir -p releases && cp \"src-tauri/target/release/bundle/dmg/\"*.dmg releases/",
    "package:win-zip": "powershell -Command \"Compress-Archive -Path src-tauri/target/release/bundle/nsis/*-setup.exe -DestinationPath Portal-POS-Windows.zip -Force\""
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bcryptjs": "^3.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.4"
  }
}
