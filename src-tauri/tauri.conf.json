{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexttel POS",
  "version": "1.0.0",
  "identifier": "com.sharedtechadnan.nexttel-pos",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexttel POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:nexttel_pos.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/zatca-signer/": "zatca-signer/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
