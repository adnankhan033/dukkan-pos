# Copy to .env.local and fill in your Google App Password (16 chars, no spaces).
# Get one at: Google Account → Security → 2-Step Verification → App passwords → Mail
# Required for store setup emails (activation keys sent to dev.adnankhan@gmail.com).
VITE_ACTIVATION_GMAIL=dev.adnankhan@gmail.com
VITE_ACTIVATION_GMAIL_APP_PASSWORD=

# Drupal backend URL — desktop app reads/writes products, orders, users from here.
# Local Lando: http://dukkan-pos-backend.lndo.site
# Production/ngrok: https://your-subdomain.ngrok-free.app
VITE_DRUPAL_API_URL=http://dukkan-pos-backend.lndo.site
